{
  "name": "visual-reference-library",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "main": "src/worker.js",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/atlas/*"]
  },
  "routes": [{ "pattern": "visual-library.peiiii.com", "custom_domain": true }]
}
